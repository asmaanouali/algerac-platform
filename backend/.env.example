# Database
DB_URL=jdbc:postgresql://localhost:5432/algerac_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Server
SERVER_PORT=8082
DDL_AUTO=validate
SQL_INIT_MODE=never
COOKIE_SECURE=true

# Security
# Keyed-hash secret for OTP codes (password reset / 2FA login). Required in production:
# without it, a random key is generated at startup and all pending OTPs are invalidated
# on every restart. Generate with e.g. `openssl rand -base64 32`.
OTP_HASH_SECRET=
# Comma-separated IPs of trusted reverse proxies allowed to set X-Forwarded-For.
# Leave empty unless the app sits behind a reverse proxy/load balancer.
TRUSTED_PROXIES=

# Email (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Application emails
NOTIFICATION_EMAIL=notifications@yourdomain.com
DT_EMAIL=dt@yourdomain.com
GES_COMPETENCES_EMAIL=competences@yourdomain.com
DAG_EMAIL=dag@yourdomain.com
