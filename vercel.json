{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://algerac-backend-production.up.railway.app/api/:path*" },
    { "source": "/((?!api/|locales/|assets/).*)", "destination": "/index.html" }
  ]
}
